# ---------------------------------------------------------------------------
# MSE CLI — example environment configuration
#
# The CLI works fully WITHOUT any of these (rule-based mode). They only matter
# when you opt into AI extraction with `--ai openai`.
#
# API key resolution order (highest priority first):
#   1. --api-key <key>      (CLI flag, one-shot override)
#   2. OPENAI_API_KEY       (this environment variable)
#   3. ~/.mse/config.json   (written by `mse init`)
#
# Copy this file to `.env` for local use, OR export the variable in your shell.
# `.env` is gitignored. The key is NEVER printed or logged by the CLI.
# ---------------------------------------------------------------------------

# Your OpenAI API key (optional).
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the default OpenAI model (default: gpt-4o-mini).
# MSE_OPENAI_MODEL=gpt-4o-mini
