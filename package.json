{
  "name": "mse-cli",
  "version": "0.1.0",
  "description": "Micro Simulation Engine — a scientific CLI for modeling uncertainty in human decisions using Monte Carlo simulation with optional AI-assisted factor extraction.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "mse": "dist/bin/mse.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/mse.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:core": "node scripts/check-core-isolation.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "verify": "npm run check:core && npm run typecheck && npm run build && npm test && npm run check:determinism",
    "demo": "node scripts/make-demo-cast.mjs && npx --yes svg-term-cli --in assets/demo.cast --out assets/demo.svg --window --width 84",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "simulation",
    "decision engine",
    "monte carlo",
    "cli",
    "uncertainty modeling",
    "probability",
    "decision making",
    "beta distribution",
    "risk analysis"
  ],
  "license": "MIT",
  "author": "The mse-cli authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halildogan/mse-cli.git"
  },
  "homepage": "https://github.com/halildogan/mse-cli#readme",
  "bugs": {
    "url": "https://github.com/halildogan/mse-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "openai": "^6.43.0",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
